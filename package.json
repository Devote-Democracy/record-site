{
  "name": "record-site",
  "version": "0.1.0",
  "private": true,
  "description": "record.devotedemocracy.com: the Devote Public Record, verified in your browser.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "demo": "node --experimental-strip-types --no-warnings scripts/make-demo-log.ts && VITE_DEMO=1 vite",
    "demo:data": "node --experimental-strip-types --no-warnings scripts/make-demo-log.ts",
    "typecheck": "tsc -b",
    "build": "npm run typecheck && vite build",
    "preview": "vite build && vite preview"
  },
  "dependencies": {
    "@devotedemocracy/record-verifier": "github:Devote-Democracy/record-verifier",
    "@semaphore-protocol/proof": "^4.14.5",
    "lucide-react": "0.577.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "7.18.4"
  },
  "devDependencies": {
    "@semaphore-protocol/group": "^4.14.5",
    "@semaphore-protocol/identity": "^4.14.5",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.19.9",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "wrangler": "4.149.0"
  }
}
